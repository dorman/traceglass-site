# Local / CI shape. Copy to .env.local for `next dev` / `next build`.
# SKIP_ENV_VALIDATION=1 bypasses checks for lint/typecheck/unit tests.

# --- Required for the public marketing site on Vercel ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notion waitlist + contact (required at runtime for those POST routes; 503 if unset)
NOTION_TOKEN=""
NOTION_WAITLIST_DB_ID=""
NOTION_CONTACT_DB_ID=""

# Notion waitlist DB properties expected by src/lib/waitlist/notion.ts:
#   Email (title), Signed up (date), Source (select; uses "website"),
#   Headline variant (select; "A" | "B"), Notes (rich_text)
#
# Notion contact DB properties expected by src/lib/contact/notion.ts:
#   Name (title; name or email), Email (email), Topic (select),
#   Message (rich_text), Received (date), Status (select; default "New")

# --- Optional: Postgres / auth / Polsia (admin, login, CMS edits, Stripe) ---
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/traceglass_site"
# BETTER_AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
# BETTER_AUTH_URL="http://localhost:3000"
# POLSIA_EMAIL_PROXY_URL="http://127.0.0.1:43987"
# POLSIA_OWNER_EMAIL="owner@example.com"
